# Leave empty to use same-origin API paths (recommended with the Vite dev proxy).
# Set to the deployed HTTPS API origin when the frontend and backend are separate.
VITE_API_BASE_URL=

# Optional target used only by the Vite development proxy.
# QORDIC_API_PROXY_TARGET=http://127.0.0.1:8000

# Public EmailJS browser configuration. Never add an EmailJS private key here.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
