# Copy to backend/.env and set unique values before starting the API.
QORDIC_DATABASE_PATH=./backend/data/qordic-ai.sqlite3
QORDIC_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
QORDIC_JWT_SECRET=replace-with-at-least-32-random-bytes
QORDIC_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
QORDIC_AI_BASE_URL=https://api.openai.com/v1
QORDIC_AI_API_KEY=
QORDIC_AI_CHAT_MODEL=gpt-4o-mini
QORDIC_AI_EMBEDDING_MODEL=text-embedding-3-small
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
QORDIC_MAX_UPLOAD_BYTES=10485760
QORDIC_RETENTION_DAYS=90
