{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/services", "destination": "/index.html" },
        { "source": "/solutions", "destination": "/index.html" },
        { "source": "/process", "destination": "/index.html" },
        { "source": "/global", "destination": "/index.html" },
        { "source": "/about", "destination": "/index.html" },
        { "source": "/blog", "destination": "/index.html" },
        { "source": "/faq", "destination": "/index.html" },
        { "source": "/estimate", "destination": "/index.html" },
        { "source": "/contact", "destination": "/index.html" },
        { "source": "/start-project", "destination": "/index.html" },
        { "source": "/privacy", "destination": "/index.html" },
        { "source": "/terms", "destination": "/index.html" },
        { "source": "/admin/ai", "destination": "/index.html" }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/blog",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/estimate",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/admin/ai",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/services/", "destination": "/services", "permanent": true },
    { "source": "/solutions/", "destination": "/solutions", "permanent": true },
    { "source": "/process/", "destination": "/process", "permanent": true },
    { "source": "/global/", "destination": "/global", "permanent": true },
    { "source": "/about/", "destination": "/about", "permanent": true },
    { "source": "/blog/", "destination": "/blog", "permanent": true },
    { "source": "/faq/", "destination": "/faq", "permanent": true },
    { "source": "/estimate/", "destination": "/estimate", "permanent": true },
    { "source": "/contact/", "destination": "/contact", "permanent": true },
    { "source": "/start-project/", "destination": "/start-project", "permanent": true },
    { "source": "/privacy/", "destination": "/privacy", "permanent": true },
    { "source": "/terms/", "destination": "/terms", "permanent": true },
    { "source": "/admin/ai/", "destination": "/admin/ai", "permanent": true },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.qordictech.com"
        }
      ],
      "destination": "https://qordictech.com/$1",
      "permanent": true
    }
  ]
}
